---
interface Tab {
  label: string;
  href: string;
  count?: number;
  isActive: boolean;
}
interface Props {
  tabs: Tab[];
}
const { tabs } = Astro.props;
---

<nav class="tabs" aria-label="Filtros">
  {
    tabs.map((t) => (
      <a href={t.href} class:list={[{ active: t.isActive }]}>
        {t.label}
        {typeof t.count === 'number' && (
          <>
            {' · '}
            <span>{t.count}</span>
          </>
        )}
      </a>
    ))
  }
</nav>
