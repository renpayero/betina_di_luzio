---
interface Props {
  href?: string;
  title: string;
  icon: 'edit' | 'duplicate' | 'delete' | 'view' | 'sort';
  danger?: boolean;
  type?: 'button' | 'submit';
  formId?: string;
}
const { href, title, icon, danger = false, type = 'button', formId } = Astro.props;

const paths: Record<typeof icon, string> = {
  edit: '<path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4z"/>',
  duplicate:
    '<rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>',
  delete:
    '<path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>',
  view: '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>',
  sort: '<path d="M3 6h18M3 12h12M3 18h6"/>',
};
const klass = ['icon-action', danger ? 'danger' : ''].filter(Boolean).join(' ');
---

{
  href ? (
    <a href={href} class={klass} title={title} aria-label={title}>
      <svg viewBox="0 0 24 24" set:html={paths[icon]} />
    </a>
  ) : (
    <button
      type={type}
      class={klass}
      title={title}
      aria-label={title}
      form={formId}
    >
      <svg viewBox="0 0 24 24" set:html={paths[icon]} />
    </button>
  )
}
