---
interface Props {
  pathname: string;
}
const { pathname } = Astro.props;

const items: ReadonlyArray<{ href: string; label: string; icon: string }> = [
  {
    href: '/admin',
    label: 'Dashboard',
    icon: '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>',
  },
  {
    href: '/admin/productos',
    label: 'Productos',
    icon: '<path d="M20 7L12 3 4 7l8 4 8-4z"/><path d="M4 7v10l8 4 8-4V7"/><path d="M12 11v10"/>',
  },
  {
    href: '/admin/categorias',
    label: 'Categorías',
    icon: '<path d="M3 7h18M3 12h18M3 17h18"/>',
  },
  {
    href: '/admin/stock',
    label: 'Stock',
    icon: '<path d="M3 9l9-6 9 6v12H3z"/><path d="M9 21V12h6v9"/>',
  },
  {
    href: '/admin/cupones',
    label: 'Cupones',
    icon: '<path d="M20 12l-8-8H4v8l8 8z"/><circle cx="9" cy="9" r="1"/>',
  },
  {
    href: '/admin/contenido',
    label: 'Contenido',
    icon: '<path d="M4 4h16v16H4z"/><path d="M4 9h16M9 4v16"/>',
  },
];

const isActive = (href: string): boolean =>
  href === '/admin' ? pathname === '/admin' : pathname.startsWith(href);
---

<aside class="admin-side" aria-label="Navegación admin">
  <a href="/admin" class="admin-brand">
    Betina<span style="color:var(--terracota-200); font-style:italic;"> · </span
    >Di Luzio
    <small>Panel · Lili</small>
  </a>
  <ul class="admin-nav">
    {
      items.map((it) => (
        <li>
          <a
            href={it.href}
            aria-current={isActive(it.href) ? 'page' : undefined}
            class:list={[{ active: isActive(it.href) }]}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={it.icon} />
            {it.label}
          </a>
        </li>
      ))
    }
  </ul>
</aside>
