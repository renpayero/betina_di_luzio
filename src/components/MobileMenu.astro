---
interface Props {
  active?:
    | 'home'
    | 'tienda'
    | 'nosotros'
    | 'contacto'
    | 'cuidados'
    | 'login'
    | 'carrito';
}
const { active } = Astro.props;
const isActive = (key: NonNullable<Props['active']>) =>
  active === key ? 'page' : undefined;
---

<div
  id="mobile-menu"
  class="mobile-menu"
  data-mobile-menu
  data-state="closed"
  aria-hidden="true"
>
  <div class="mobile-menu__backdrop" data-mobile-menu-backdrop></div>

  <aside
    class="mobile-menu__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="mobile-menu-title"
    tabindex="-1"
    data-mobile-menu-panel
  >
    <header class="mobile-menu__head">
      <a
        href="/"
        id="mobile-menu-title"
        class="mobile-menu__brand"
        data-mobile-menu-link
      >
        <span>Betina<span class="ampersand"> · </span>Di Luzio</span>
        <small>Tejidos · 2011</small>
      </a>
      <button
        type="button"
        class="mobile-menu__close"
        aria-label="Cerrar menú"
        data-mobile-menu-close
      >
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
          width="22"
          height="22"
        >
          <path
            d="M6 6l12 12M18 6L6 18"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            fill="none"></path>
        </svg>
      </button>
    </header>

    <nav class="mobile-menu__nav" aria-label="Navegación móvil">
      <ul class="mobile-menu__links">
        <li>
          <a
            href="/"
            aria-current={isActive('home')}
            data-mobile-menu-link>Inicio</a
          >
        </li>
        <li>
          <a
            href="/tienda"
            aria-current={isActive('tienda')}
            data-mobile-menu-link>Tienda</a
          >
        </li>
        <li>
          <a
            href="/nosotros"
            aria-current={isActive('nosotros')}
            data-mobile-menu-link>Nosotros</a
          >
        </li>
        <li>
          <a
            href="/cuidados"
            aria-current={isActive('cuidados')}
            data-mobile-menu-link>Cuidados</a
          >
        </li>
        <li>
          <a
            href="/contacto"
            aria-current={isActive('contacto')}
            data-mobile-menu-link>Contacto</a
          >
        </li>
      </ul>
    </nav>

    <footer class="mobile-menu__foot">
      <a
        href="/login"
        class="mobile-menu__action"
        aria-current={isActive('login')}
        data-mobile-menu-link
      >
        <svg
          class="mobile-menu__action-icon"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <circle cx="12" cy="8" r="4"></circle>
          <path d="M4 20c0-4 4-7 8-7s8 3 8 7"></path>
        </svg>
        <span>Ingresar</span>
      </a>
      <a
        href="/carrito"
        class="mobile-menu__action"
        aria-current={isActive('carrito')}
        data-mobile-menu-link
      >
        <span class="mobile-menu__action-cart">
          <svg
            class="mobile-menu__action-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M6 7h12l-1.5 11.5a2 2 0 0 1-2 1.5h-5a2 2 0 0 1-2-1.5L6 7z"
            ></path>
            <path d="M9 7V5a3 3 0 0 1 6 0v2"></path>
          </svg>
          <span
            class="mobile-menu__action-count"
            data-cart-count
            style="display:none"
            aria-live="polite"
            aria-atomic="true">0</span
          >
        </span>
        <span>Carrito</span>
      </a>
    </footer>
  </aside>
</div>

<script>
  import { initMobileMenu } from '../scripts/mobile-menu.ts';
  document.addEventListener('astro:page-load', initMobileMenu);
</script>
