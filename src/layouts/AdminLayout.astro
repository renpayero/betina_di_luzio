---
import { ClientRouter } from 'astro:transitions';
import AdminNav from '../components/AdminNav.astro';
import Flash from '../components/admin/Flash.astro';
import '../styles/global.css';
import '../styles/admin.css';

interface Props {
  title: string;
  greeting?: string;
  subtitle?: string;
}

const { title, greeting, subtitle } = Astro.props;
const user = Astro.locals.user!;
const pathname = Astro.url.pathname;
const heading = greeting ?? title;
const initial = (user.name ?? user.email ?? 'B').trim().charAt(0).toUpperCase();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} · Admin · Betina Di Luzio</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter fallback="swap" />
  </head>
  <body class="admin">
    <a href="#main" class="skip-link">Saltar al contenido</a>
    <div class="admin-shell">
      <AdminNav pathname={pathname} />

      <main id="main" class="admin-main" tabindex="-1">
        <header class="admin-header">
          <div>
            <h1>{heading}</h1>
            {subtitle && <p>{subtitle}</p>}
          </div>
          <div class="actions">
            <a href="/" class="back-to-site" aria-label="Volver al sitio público" title="Ver tienda">
              <svg viewBox="0 0 24 24" aria-hidden="true" stroke="currentColor" fill="none" stroke-width="1.6">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <path d="M15 3h6v6M10 14L21 3"/>
              </svg>
              <span>Ver sitio</span>
            </a>
            <div class="user-chip">
              <span class="avatar">{initial}</span>
              <span>{user.name}</span>
            </div>
            <form method="post" action="/api/auth/logout" class="logout-form">
              <button type="submit" class="logout-btn">Salir</button>
            </form>
          </div>
        </header>

        <Flash />

        <slot />
      </main>
    </div>

    <script>
      import { initCounters } from '../scripts/reveal.ts';
      import { initAdminFilter } from '../scripts/admin-filter.ts';
      import { initConfirmForms } from '../scripts/admin-confirm.ts';
      const runAll = () => {
        initCounters();
        initAdminFilter();
        initConfirmForms();
      };
      runAll();
      document.addEventListener('astro:page-load', runAll);
    </script>
  </body>
</html>
