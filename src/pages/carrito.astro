---
import BaseLayout from '../layouts/BaseLayout.astro';
import { WHATSAPP_NUMBER } from '../lib/constants.ts';
---

<BaseLayout
  title="Carrito"
  description="Revisá tu selección y coordiná pago y envío directamente por WhatsApp."
  active="carrito"
  noindex
>
  <div class="cart-page" data-wa={WHATSAPP_NUMBER}>
    <h1 class="serif">Tu <em>carrito</em>.</h1>
    <div id="cart-content" aria-live="polite"></div>
  </div>
</BaseLayout>

<style>
  .cart-page {
    padding: 140px var(--s-7) 100px;
    max-width: 1280px;
    margin: 0 auto;
  }
  .cart-page h1 {
    font-size: var(--t-h1);
    margin-bottom: 48px;
  }
  .cart-page h1 em {
    font-style: italic;
    color: var(--accent-deep);
  }

  :global(.cart-grid) { display: grid; grid-template-columns: 1fr 380px; gap: 48px; }
  :global(.cart-items) { border-top: 1px solid var(--line); }
  :global(.cart-row) {
    display: grid; grid-template-columns: 110px 1fr auto;
    gap: 24px; padding: 28px 0;
    border-bottom: 1px solid var(--line); align-items: center;
  }
  :global(.cart-row .img) { aspect-ratio: 3 / 4; height: 140px; position: relative; overflow: hidden; }
  :global(.cart-row .img .placeholder-img) { position: absolute; inset: 0; }
  :global(.cart-row h3) { font-family: var(--serif); font-size: 22px; margin-bottom: 6px; }
  :global(.cart-row .opts) {
    display: flex; gap: 16px;
    font-family: var(--mono); font-size: 11px;
    color: var(--ink-soft); text-transform: uppercase; letter-spacing: 0.12em;
    margin-bottom: 12px;
  }
  :global(.cart-row .opts .swatch) {
    width: 12px; height: 12px; border-radius: 50%;
    display: inline-block; vertical-align: middle; margin-right: 6px;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }
  :global(.cart-row .row-bot) { display: flex; gap: 24px; align-items: center; }
  :global(.cart-row .qty-ctrl) { display: flex; border: 1px solid var(--line); border-radius: 4px; }
  :global(.cart-row .qty-ctrl button) { width: 32px; height: 36px; }
  :global(.cart-row .qty-ctrl span) { width: 36px; text-align: center; font-family: var(--mono); line-height: 36px; }
  :global(.cart-row .remove) {
    font-family: var(--mono); font-size: 11px;
    color: var(--ink-soft); text-transform: uppercase; letter-spacing: 0.12em;
    transition: color 0.2s;
  }
  :global(.cart-row .remove:hover) { color: var(--accent); text-decoration: underline; }
  :global(.cart-row .price-col) { text-align: right; }
  :global(.cart-row .price-col .price) { font-family: var(--mono); font-size: 16px; }

  :global(.summary) {
    background: var(--bg-warm); padding: 32px; border-radius: 4px;
    align-self: start; position: sticky; top: 110px;
  }
  :global(.summary h3) { font-family: var(--serif); font-size: 28px; margin-bottom: 24px; }
  :global(.summary-row) {
    display: flex; justify-content: space-between;
    padding: 12px 0; font-family: var(--mono); font-size: 13px;
  }
  :global(.summary-row.total) {
    font-family: var(--serif); font-size: 24px;
    padding-top: 24px; border-top: 1px solid var(--line); margin-top: 12px;
  }
  :global(.summary .promo) { display: flex; gap: 8px; margin: 24px 0; }
  :global(.summary .promo input) {
    flex: 1; padding: 12px;
    border: 1px solid var(--line); border-radius: 4px;
    font-family: var(--mono); font-size: 12px;
  }
  :global(.summary .promo button) {
    padding: 12px 16px;
    background: var(--ink); color: var(--bg); border-radius: 4px;
    font-family: var(--mono); font-size: 11px; text-transform: uppercase;
  }
  :global(.summary .checkout) {
    width: 100%; padding: 18px;
    background: #25d366; color: white; border-radius: 999px;
    display: flex; align-items: center; justify-content: center; gap: 12px;
    font-family: var(--mono); font-size: 12px; text-transform: uppercase;
    letter-spacing: 0.18em; margin-top: 24px;
  }
  :global(.summary .checkout:hover) { background: #1fb959; }
  :global(.summary .checkout svg) { width: 16px; height: 16px; fill: currentColor; }
  :global(.summary .secondary-link) {
    text-align: center; display: block; margin-top: 16px;
    font-family: var(--mono); font-size: 11px; text-transform: uppercase;
    letter-spacing: 0.12em; color: var(--ink-soft);
  }
  :global(.summary .secondary-link:hover) { color: var(--accent-deep); }

  :global(.empty-cart) { text-align: center; padding: 80px 20px; }
  :global(.empty-cart h2) { font-family: var(--serif); font-size: 48px; margin-bottom: 16px; }
  :global(.empty-cart p) {
    color: var(--ink-soft); margin-bottom: 32px;
    font-family: var(--serif); font-style: italic; font-size: 20px;
  }

  @media (max-width: 900px) {
    :global(.cart-grid) { grid-template-columns: 1fr; }
    :global(.summary) { position: static; }
  }
</style>

<script>
  import { cart, CART_CHANGE_EVENT } from '../lib/cart.ts';
  import { fmtARS } from '../lib/format.ts';
  import { colorName } from '../lib/colors.ts';

  const escape = (s: string): string =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  const buildWaUrl = (
    items: ReturnType<typeof cart.items>,
    subtotal: number,
    wa: string
  ): string => {
    const lines = items.map(
      (i) =>
        `• ${i.name} — Talle ${i.size ?? ''}, ${colorName(i.color ?? '')} (x${i.qty}) → ${fmtARS(i.price * i.qty)}`
    );
    const msg = `Hola Betina! Quería coordinar este pedido:\n\n${lines.join('\n')}\n\nTotal: ${fmtARS(subtotal)}\n¿Coordinamos pago y envío?`;
    return `https://wa.me/${wa}?text=${encodeURIComponent(msg)}`;
  };

  const render = () => {
    const page = document.querySelector<HTMLElement>('.cart-page');
    const root = document.getElementById('cart-content');
    if (!page || !root) return;
    const wa = page.dataset.wa ?? '';
    const items = cart.items();

    if (!items.length) {
      root.innerHTML = `
        <div class="empty-cart">
          <h2 class="serif">Tu carrito está vacío.</h2>
          <p>Pero hay tantas cosas lindas esperándote...</p>
          <a href="/tienda" class="btn btn-primary">Explorar la tienda</a>
        </div>`;
      return;
    }

    const subtotal = cart.total();
    root.innerHTML = `
      <div class="cart-grid">
        <div class="cart-items">
          ${items
            .map(
              (it) => `
              <div class="cart-row" data-key="${escape(it.key)}">
                <div class="img"><div class="placeholder-img"><div class="placeholder-label" style="font-size:9px;">${escape((it.placeholder ?? '').slice(0, 30))}</div></div></div>
                <div>
                  <h3>${escape(it.name)}</h3>
                  <div class="opts">
                    ${it.color ? `<span><span class="swatch" style="background:${escape(it.color)}"></span>${escape(colorName(it.color))}</span>` : ''}
                    ${it.size ? `<span>Talle ${escape(it.size)}</span>` : ''}
                  </div>
                  <div class="row-bot">
                    <div class="qty-ctrl">
                      <button data-action="dec" aria-label="Disminuir">−</button>
                      <span>${it.qty}</span>
                      <button data-action="inc" aria-label="Aumentar">+</button>
                    </div>
                    <button class="remove" data-action="remove">Quitar</button>
                  </div>
                </div>
                <div class="price-col"><span class="price">${fmtARS(it.price * it.qty)}</span></div>
              </div>`
            )
            .join('')}
        </div>
        <aside class="summary" aria-label="Resumen del pedido">
          <h3>Resumen</h3>
          <div class="summary-row"><span>Subtotal</span><span>${fmtARS(subtotal)}</span></div>
          <div class="summary-row"><span>Envío</span><span style="color:var(--ink-soft)">A coordinar</span></div>
          <div class="promo">
            <label class="sr-only" for="promo-input">Código de descuento</label>
            <input id="promo-input" type="text" placeholder="Código de descuento" />
            <button type="button">Aplicar</button>
          </div>
          <div class="summary-row total"><span>Total</span><span>${fmtARS(subtotal)}</span></div>
          <a href="${escape(buildWaUrl(items, subtotal, wa))}" target="_blank" rel="noopener" class="checkout">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24z"/></svg>
            Coordinar por WhatsApp
          </a>
          <a href="/tienda" class="secondary-link">← Seguir comprando</a>
        </aside>
      </div>`;

    root.querySelectorAll<HTMLElement>('.cart-row').forEach((row) => {
      const key = row.dataset.key!;
      const cur = items.find((x) => x.key === key);
      if (!cur) return;
      row.querySelector<HTMLButtonElement>('[data-action="dec"]')?.addEventListener('click', () => cart.setQty(key, cur.qty - 1));
      row.querySelector<HTMLButtonElement>('[data-action="inc"]')?.addEventListener('click', () => cart.setQty(key, cur.qty + 1));
      row.querySelector<HTMLButtonElement>('[data-action="remove"]')?.addEventListener('click', () => cart.remove(key));
    });
  };

  document.addEventListener('astro:page-load', render);
  window.addEventListener(CART_CHANGE_EVENT, render);
</script>
