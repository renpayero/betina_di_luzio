---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import {
  getCategories,
  getCategoryCounts,
  getProductsWithHero,
  type ProductFilter,
} from '../lib/queries.ts';
import { colorName } from '../lib/colors.ts';

const url = Astro.url;
const cat = url.searchParams.get('cat') ?? 'all';
const priceParam = url.searchParams.get('price');
const sortParam = (url.searchParams.get('sort') ?? 'featured') as
  | 'featured'
  | 'new'
  | 'price-asc'
  | 'price-desc';

const colorsParam: string[] =
  url.searchParams.get('colors')?.split(',').filter(Boolean) ?? [];
const sizesParam: string[] =
  url.searchParams.get('sizes')?.split(',').filter(Boolean) ?? [];

const PRICE_RANGES: Record<string, [number, number]> = {
  '0-40000': [0, 40000],
  '40000-80000': [40000, 80000],
  '80000-120000': [80000, 120000],
  '120000-999999': [120000, 999_999],
};

const filter: ProductFilter = { sort: sortParam };
if (cat !== 'all') filter.categoryId = cat;
if (priceParam && PRICE_RANGES[priceParam]) {
  const [mn, mx] = PRICE_RANGES[priceParam];
  filter.minPrice = mn;
  filter.maxPrice = mx;
}
if (colorsParam.length > 0) filter.colors = colorsParam;
if (sizesParam.length > 0) filter.sizes = sizesParam;

const [allCategories, counts, list, totalProducts] = await Promise.all([
  getCategories(),
  getCategoryCounts(),
  getProductsWithHero(filter),
  getProductsWithHero({}).then((p) => p.length),
]);

const buildUrl = (params: Record<string, string | null>): string => {
  const u = new URL(url);
  for (const [k, v] of Object.entries(params)) {
    if (v === null) u.searchParams.delete(k);
    else u.searchParams.set(k, v);
  }
  return u.pathname + (u.search || '');
};

const toggleInList = (list: string[], value: string): string[] =>
  list.includes(value) ? list.filter((v) => v !== value) : [...list, value];

const buildToggleUrl = (key: 'colors' | 'sizes', value: string): string => {
  const current = key === 'colors' ? colorsParam : sizesParam;
  const next = toggleInList(current, value);
  return buildUrl({ [key]: next.length > 0 ? next.join(',') : null });
};

const hasActiveFilters =
  cat !== 'all' ||
  !!priceParam ||
  colorsParam.length > 0 ||
  sizesParam.length > 0 ||
  sortParam !== 'featured';

const SWATCHES: ReadonlyArray<readonly [string, string]> = [
  ['#CB674C', 'Terracota'],
  ['#36160E', 'Tinta'],
  ['#FCF5F4', 'Crema'],
  ['#6C95B0', 'Azul polvo'],
  ['#595421', 'Olivo'],
  ['#DBD7D3', 'Crudo'],
] as const;

const SIZES = [
  ['S', 8],
  ['M', 12],
  ['L', 10],
  ['Único', 6],
  ['Bebé', 9],
] as const;
---

<BaseLayout
  title="Tienda"
  description="Tejidos artesanales hechos a mano: sweaters, cardigans, mantas, accesorios y más. Cada prenda es única."
  active="tienda"
>
  <header class="shop-header">
    <div class="container">
      <div>
        <div class="eyebrow" style="margin-bottom: 16px;">— Tienda</div>
        <h1 class="serif">
          Tejidos<br />
          <em style="color: var(--accent-deep); font-style: italic;"
            >a tu medida</em
          >.
        </h1>
      </div>
      <p>
        Cada prenda es única. Si no encontrás tu talle o querés otro color,
        escribime y lo tejo para vos.
      </p>
    </div>
  </header>

  <div class="shop-layout">
    <aside class="filters" aria-label="Filtros de productos">
      <div class="filter-group">
        <h5>Categorías</h5>
        <ul>
          <li class:list={['filter-link', { active: cat === 'all' }]}>
            <a href={buildUrl({ cat: null })}>
              Todos<span class="count">{totalProducts}</span>
            </a>
          </li>
          {
            allCategories.map((c) => (
              <li
                class:list={['filter-link', { active: cat === c.id }]}
              >
                <a href={buildUrl({ cat: c.id })}>
                  {c.name}
                  <span class="count">{counts[c.id] ?? 0}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="filter-group">
        <h5 id="filter-color">Color</h5>
        <div
          class="swatches-list"
          role="group"
          aria-labelledby="filter-color"
        >
          {
            SWATCHES.map(([hex, name]) => {
              const isOn = colorsParam.includes(hex);
              return (
                <a
                  class:list={['swatch-btn', { active: isOn }]}
                  style={`background:${hex}`}
                  href={buildToggleUrl('colors', hex)}
                  aria-label={`${colorName(hex)}${isOn ? ' (seleccionado)' : ''}`}
                  aria-pressed={isOn ? 'true' : 'false'}
                  title={name}
                  data-no-prefetch
                />
              );
            })
          }
        </div>
      </div>

      <div class="filter-group">
        <h5 id="filter-size">Talle</h5>
        <ul role="group" aria-labelledby="filter-size">
          {
            SIZES.map(([s, n]) => {
              const isOn = sizesParam.includes(s);
              return (
                <li class:list={['filter-link', { active: isOn }]}>
                  <a
                    href={buildToggleUrl('sizes', s)}
                    aria-pressed={isOn ? 'true' : 'false'}
                  >
                    {s}
                    <span class="count">{n}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>

      <div class="filter-group">
        <h5>Precio</h5>
        <ul>
          {
            (
              [
                ['0-40000', 'Hasta $40.000'],
                ['40000-80000', '$40 — $80.000'],
                ['80000-120000', '$80 — $120.000'],
                ['120000-999999', '+ $120.000'],
              ] as const
            ).map(([key, label]) => (
              <li class:list={['filter-link', { active: priceParam === key }]}>
                <a
                  href={buildUrl({
                    price: priceParam === key ? null : key,
                  })}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>

    <section aria-label="Productos">
      <div class="shop-toolbar">
        <div class="toolbar-left">
          <span class="count">{list.length} {list.length === 1 ? 'pieza' : 'piezas'}</span>
          {
            hasActiveFilters && (
              <a class="clear-filters" href="/tienda">
                Limpiar filtros
              </a>
            )
          }
        </div>
        <form method="get" id="sort-form">
          {cat !== 'all' && <input type="hidden" name="cat" value={cat} />}
          {priceParam && <input type="hidden" name="price" value={priceParam} />}
          {
            colorsParam.length > 0 && (
              <input type="hidden" name="colors" value={colorsParam.join(',')} />
            )
          }
          {
            sizesParam.length > 0 && (
              <input type="hidden" name="sizes" value={sizesParam.join(',')} />
            )
          }
          <select name="sort" id="sort">
            <option value="featured" selected={sortParam === 'featured'}
              >Destacados primero</option
            >
            <option value="new" selected={sortParam === 'new'}>Más nuevos</option>
            <option value="price-asc" selected={sortParam === 'price-asc'}
              >Precio: menor a mayor</option
            >
            <option value="price-desc" selected={sortParam === 'price-desc'}
              >Precio: mayor a menor</option
            >
          </select>
        </form>
      </div>
      {
        list.length === 0 ? (
          <div class="empty">
            <p class="serif" style="font-size: 28px; font-style: italic;">
              No encontramos piezas con esos filtros.
            </p>
            <a href="/tienda" class="btn btn-secondary" style="margin-top: 24px;">
              Ver toda la tienda
            </a>
          </div>
        ) : (
          <div class="products-grid">
            {list.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  .shop-header {
    padding: 160px 0 60px;
    background: var(--bg-warm);
    border-bottom: 1px solid var(--line);
  }
  .shop-header :global(.container) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: end;
  }
  .shop-header h1 {
    font-size: var(--t-h1);
  }
  .shop-header p {
    color: var(--ink-soft);
    max-width: 480px;
  }
  @media (max-width: 800px) {
    .shop-header :global(.container) {
      grid-template-columns: 1fr;
    }
  }

  .shop-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 48px;
    padding: 48px var(--s-7);
    max-width: 1440px;
    margin: 0 auto;
  }
  .filters {
    position: sticky;
    top: 100px;
    align-self: flex-start;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    padding-right: 8px;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }
  .filters::-webkit-scrollbar {
    width: 6px;
  }
  .filters::-webkit-scrollbar-thumb {
    background: var(--line);
    border-radius: 3px;
  }
  .filters::-webkit-scrollbar-thumb:hover {
    background: var(--ink-mute);
  }
  .filter-group {
    margin-bottom: 36px;
  }
  .filter-group h5 {
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-soft);
    margin-bottom: 16px;
  }
  .filter-group ul {
    list-style: none;
  }
  .filter-link,
  .filter-static {
    padding: 8px 0;
    border-bottom: 1px solid var(--line-soft);
    transition: padding-left 0.3s, color 0.2s;
  }
  .filter-link a {
    display: flex;
    justify-content: space-between;
    width: 100%;
  }
  .filter-link:hover {
    color: var(--accent-deep);
    padding-left: 6px;
  }
  .filter-link.active {
    color: var(--accent-deep);
    font-weight: 500;
  }
  .filter-static {
    display: flex;
    justify-content: space-between;
    color: var(--ink-soft);
  }
  .filter-group .count {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-mute);
  }

  .swatches-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .swatch-btn {
    display: inline-block;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--line);
    transition: transform 0.2s, box-shadow 0.2s, outline-color 0.2s;
    cursor: pointer;
    position: relative;
  }
  .swatch-btn:hover {
    transform: scale(1.15);
  }
  .swatch-btn.active {
    transform: scale(1.1);
    box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--accent-deep);
  }
  .swatch-btn.active::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M5 12.5l4.5 4.5L19 7' fill='none' stroke='%23FCF5F4' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/></svg>");
    background-repeat: no-repeat;
    background-position: center;
    background-size: 70%;
    mix-blend-mode: difference;
    pointer-events: none;
  }

  .shop-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
    gap: 16px;
  }
  .shop-toolbar .toolbar-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .shop-toolbar .count {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .shop-toolbar .clear-filters {
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent-deep);
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    transition: color 0.2s;
  }
  .shop-toolbar .clear-filters:hover {
    color: var(--ink);
  }
  .shop-toolbar select {
    padding: 10px 14px;
    font: inherit;
    background: white;
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-5);
  }
  .empty {
    padding: 80px 20px;
    text-align: center;
  }

  @media (max-width: 1100px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 800px) {
    .shop-layout {
      grid-template-columns: 1fr;
    }
    .filters {
      position: static;
    }
  }
</style>

<script>
  const wireSort = () => {
    const form = document.getElementById('sort-form') as HTMLFormElement | null;
    const select = document.getElementById('sort') as HTMLSelectElement | null;
    if (!form || !select) return;
    select.addEventListener('change', () => form.submit());
  };
  document.addEventListener('astro:page-load', wireSort);
</script>
