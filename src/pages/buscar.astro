---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProducts } from '../lib/queries.ts';
import type { Product } from '../db/schema.ts';

const url = Astro.url;
const qRaw = url.searchParams.get('q') ?? '';
const q = qRaw.trim();
const hasQuery = q.length > 0;

let results: Product[] = [];
if (hasQuery) {
  results = await getProducts({ q });
}

const description = hasQuery
  ? `Resultados para "${q}" en la tienda de Betina Di Luzio.`
  : 'Buscá tejidos artesanales: sweaters, mantas, accesorios, colores, texturas. Cada prenda es única.';
---

<BaseLayout
  title="Buscar"
  description={description}
  noindex
>
  <header class="search-header">
    <div class="container">
      <div class="eyebrow">— Buscador</div>
      <h1 class="serif">
        ¿Qué estás<br /><em>buscando hoy?</em>
      </h1>
      <form
        class="search-form"
        method="get"
        action="/buscar"
        role="search"
        aria-label="Buscar productos"
      >
        <label for="q" class="visually-hidden">¿Qué buscás?</label>
        <input
          id="q"
          name="q"
          type="search"
          autocomplete="off"
          autofocus
          placeholder="sweater, manta, terracota..."
          value={q}
          aria-describedby="q-hint"
          enterkeyhint="search"
        />
        <button type="submit" class="btn btn-primary">
          Buscar
          <svg
            class="arrow"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
            focusable="false"
            ><path d="M5 12h14M13 5l7 7-7 7"></path></svg
          >
        </button>
      </form>
      {
        !hasQuery && (
          <p id="q-hint" class="hint">
            Escribí qué buscás — sweater, manta, color, etc.
          </p>
        )
      }
    </div>
  </header>

  {
    hasQuery && (
      <section class="search-results" aria-label="Resultados de búsqueda">
        <div class="results-head">
          <h2 class="serif">
            {results.length > 0
              ? `Resultados para «${q}»`
              : `Sin resultados para «${q}»`}
          </h2>
          <span class="count" aria-live="polite">
            {results.length} {results.length === 1 ? 'pieza' : 'piezas'}
          </span>
        </div>

        {results.length > 0 ? (
          <div class="products-grid">
            {results.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        ) : (
          <div class="empty">
            <p class="serif">
              No encontramos nada con eso. Probá con otra palabra o explorá la
              tienda.
            </p>
            <a
              href="/tienda"
              class="btn btn-secondary"
              style="margin-top: 24px;"
            >
              Ver toda la tienda
            </a>
          </div>
        )}
      </section>
    )
  }
</BaseLayout>

<style>
  .search-header {
    padding: 160px 0 60px;
    background: var(--bg-warm);
    border-bottom: 1px solid var(--line);
  }
  .search-header :global(.container) {
    max-width: 880px;
  }
  .search-header .eyebrow {
    color: var(--accent-deep);
    margin-bottom: 16px;
  }
  .search-header h1 {
    font-size: var(--t-h1);
    line-height: 1;
    margin-bottom: 32px;
  }
  .search-header h1 em {
    font-style: italic;
    color: var(--accent-deep);
  }

  .search-form {
    display: flex;
    gap: 12px;
    align-items: stretch;
    margin-top: 24px;
    max-width: 640px;
  }
  .search-form input[type='search'] {
    flex: 1;
    padding: 14px 18px;
    font: inherit;
    font-size: 17px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--ink);
  }
  .search-form input[type='search']::placeholder {
    color: var(--ink-mute);
  }
  .search-form input[type='search']:focus-visible {
    border-color: var(--accent-deep);
  }
  .search-form button {
    flex-shrink: 0;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hint {
    margin-top: 18px;
    color: var(--ink-soft);
    font-style: italic;
    font-family: var(--serif);
    font-size: 18px;
  }

  .search-results {
    padding: 64px var(--s-7);
    max-width: 1440px;
    margin: 0 auto;
  }
  .results-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 32px;
    gap: 16px;
    flex-wrap: wrap;
  }
  .results-head h2 {
    font-size: var(--t-h3);
  }
  .results-head .count {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-5);
  }
  @media (max-width: 1100px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .products-grid {
      grid-template-columns: 1fr;
    }
    .search-form {
      flex-direction: column;
    }
  }

  .empty {
    padding: 60px 20px;
    text-align: center;
    color: var(--ink-soft);
  }
  .empty p {
    font-size: 24px;
    font-style: italic;
    max-width: 540px;
    margin: 0 auto;
    line-height: 1.5;
  }
</style>
