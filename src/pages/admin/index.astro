---
import AdminLayout from '../../layouts/AdminLayout.astro';
import {
  getAdminLowStock,
  getAdminProductCount,
  getAdminTopValueProducts,
  getCategories,
  getCategoryCounts,
} from '../../lib/queries.ts';
import { fmtARS } from '../../lib/format.ts';

const [productCount, lowStock, topValue, categories, categoryCounts] =
  await Promise.all([
    getAdminProductCount(),
    getAdminLowStock(),
    getAdminTopValueProducts(5),
    getCategories(),
    getCategoryCounts(),
  ]);

const totalLowStock = lowStock.length;
---

<AdminLayout title="Dashboard">
  <section class="kpi-grid">
    <article class="kpi-card kpi-card--hero">
      <div class="kpi-card__label">— Catálogo</div>
      <div class="kpi-card__value">{productCount}</div>
      <div class="kpi-card__caption">productos publicados</div>
    </article>

    <article class="kpi-card">
      <div class="kpi-card__label">— Alerta de stock</div>
      <div
        class="kpi-card__value"
        data-tone={totalLowStock > 0 ? 'warn' : 'ok'}
      >
        {totalLowStock}
      </div>
      <div class="kpi-card__caption">
        piezas con ≤ 3 unidades
      </div>
    </article>

    <article class="kpi-card">
      <div class="kpi-card__label">— Categorías activas</div>
      <div class="kpi-card__value">{categories.length}</div>
      <div class="kpi-card__caption">familias del catálogo</div>
    </article>
  </section>

  <section class="panel-grid">
    <article class="panel">
      <header class="panel__head">
        <h2>Stock bajo</h2>
        <span class="panel__sub">≤ 3 unidades</span>
      </header>
      {
        lowStock.length === 0 ? (
          <p class="panel__empty">Todo en stock saludable.</p>
        ) : (
          <ul class="row-list">
            {lowStock.map((p) => (
              <li class="row-list__item">
                <a href={`/producto/${p.slug}`} class="row-list__name">
                  {p.name}
                </a>
                <span
                  class="row-list__pill"
                  data-tone={p.stock <= 1 ? 'danger' : 'warn'}
                >
                  {p.stock} u.
                </span>
              </li>
            ))}
          </ul>
        )
      }
    </article>

    <article class="panel">
      <header class="panel__head">
        <h2>Top valor</h2>
        <span class="panel__sub">mock · placeholder de "más vendidos"</span>
      </header>
      <ul class="row-list">
        {
          topValue.map((p, i) => (
            <li class="row-list__item">
              <span class="row-list__rank">{String(i + 1).padStart(2, '0')}</span>
              <a href={`/producto/${p.slug}`} class="row-list__name">
                {p.name}
              </a>
              <span class="row-list__price">{fmtARS(p.price)}</span>
            </li>
          ))
        }
      </ul>
    </article>

    <article class="panel">
      <header class="panel__head">
        <h2>Por categoría</h2>
        <span class="panel__sub">distribución actual</span>
      </header>
      <ul class="row-list">
        {
          categories.map((c) => (
            <li class="row-list__item">
              <span class="row-list__name">{c.name}</span>
              <span class="row-list__pill">{categoryCounts[c.id] ?? 0}</span>
            </li>
          ))
        }
      </ul>
    </article>
  </section>

  <p class="phase2-note">
    Las secciones <strong>Productos</strong>, <strong>Categorías</strong>,
    <strong>Stock</strong>, <strong>Cupones</strong> y <strong>Contenido</strong>
    quedan pendientes para Phase 2 — el shell ya está listo para sumarles CRUDs.
  </p>
</AdminLayout>

<style>
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 32px;
  }
  .kpi-card {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .kpi-card--hero {
    background: var(--bg-warm);
  }
  .kpi-card__label {
    font-family: var(--mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--accent-deep);
  }
  .kpi-card__value {
    font-family: var(--serif);
    font-size: 64px;
    line-height: 1;
    font-weight: 500;
    color: var(--ink);
  }
  .kpi-card__value[data-tone='warn'] {
    color: var(--terracota-700);
  }
  .kpi-card__value[data-tone='ok'] {
    color: var(--olivo-700);
  }
  .kpi-card__caption {
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-mute);
  }

  .panel-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }
  .panel {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
  }
  .panel__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--line-soft);
    padding-bottom: 10px;
  }
  .panel__head h2 {
    font-family: var(--serif);
    font-size: 20px;
    font-weight: 500;
  }
  .panel__sub {
    font-family: var(--mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-mute);
  }
  .panel__empty {
    font-family: var(--serif);
    font-style: italic;
    color: var(--ink-soft);
  }

  .row-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .row-list__item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .row-list__item:last-child {
    border-bottom: none;
  }
  .row-list__rank {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-mute);
    width: 24px;
  }
  .row-list__name {
    font-family: var(--sans);
    font-size: 14px;
    color: var(--ink);
    flex: 1;
  }
  a.row-list__name:hover {
    color: var(--accent-deep);
    text-decoration: underline;
  }
  .row-list__price {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-soft);
  }
  .row-list__pill {
    font-family: var(--mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    background: var(--bg-warm);
    color: var(--ink-soft);
    padding: 4px 10px;
    border-radius: var(--radius-pill);
  }
  .row-list__pill[data-tone='warn'] {
    background: var(--terracota-100);
    color: var(--terracota-900);
  }
  .row-list__pill[data-tone='danger'] {
    background: var(--terracota-500);
    color: var(--bg);
  }

  .phase2-note {
    margin-top: 16px;
    padding: 16px 20px;
    background: var(--bg-warm);
    border-radius: var(--radius-sm);
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .phase2-note strong {
    color: var(--accent-deep);
  }

  @media (max-width: 1100px) {
    .kpi-grid,
    .panel-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
