---
import AdminLayout from '../../layouts/AdminLayout.astro';
import KpiCard from '../../components/admin/KpiCard.astro';
import Tag from '../../components/admin/Tag.astro';
import {
  getAdminLowStock,
  getAdminCategoriesWithCounts,
  getAdminProductsCountByStatus,
  getStockKpis,
  getCouponKpis,
  getAdminTopValueProducts,
} from '../../lib/queries.ts';
import { fmtARS } from '../../lib/format.ts';

const user = Astro.locals.user!;
const firstName = (user.name ?? 'Lili').split(' ')[0] ?? 'Lili';

const [productCounts, lowStock, cats, stock, couponKpis, topProducts] =
  await Promise.all([
    getAdminProductsCountByStatus(),
    getAdminLowStock(3),
    getAdminCategoriesWithCounts(),
    getStockKpis(),
    getCouponKpis(),
    getAdminTopValueProducts(5),
  ]);

const totalProductsByCat = cats.reduce((a, b) => a + b.productCount, 0);
const palette = ['#CB674C', '#595421', '#6C95B0', '#984C37', '#918B85', '#653022'];
let cursor = 0;
const donutSegments = cats.map((c, i) => {
  const pct = totalProductsByCat
    ? Math.round((c.productCount / totalProductsByCat) * 100)
    : 0;
  const seg = {
    name: c.name,
    pct,
    color: palette[i % palette.length] ?? '#CB674C',
    dasharray: `${pct} ${100 - pct}`,
    dashoffset: -cursor,
  };
  cursor += pct;
  return seg;
});

const topCatPct = donutSegments[0]?.pct ?? 0;
const maxCatCount = Math.max(...cats.map((c) => c.productCount), 1);
const donutWithCat = donutSegments.map((s) => {
  const cat = cats.find((c) => c.name === s.name);
  return { ...s, catId: cat?.id ?? '' };
});
---

<AdminLayout
  title="Dashboard"
  greeting={`Buen día, ${firstName}.`}
  subtitle="Esto es lo que pasa en tu tienda hoy."
>
  <section class="kpis">
    <KpiCard
      label="Productos en catálogo"
      count={productCounts.total}
      delta={`${productCounts.published} publicados · ${productCounts.draft} borrador`}
      trend="up"
      spark="0,22 10,18 20,20 30,12 40,15 52,8 64,4"
      href="/admin/productos"
    />
    <KpiCard
      label="Valor de inventario"
      count={stock.inventoryValue}
      format="ars"
      delta={`${stock.totalUnits} unidades en ${stock.productCount} piezas`}
      trend="up"
      spark="0,20 10,16 20,18 30,10 40,12 52,6 64,8"
      href="/admin/stock"
    />
    <KpiCard
      label="Stock crítico"
      count={stock.criticalCount}
      delta={stock.criticalCount > 0 ? `Reponer · ${stock.restockCount} bajo mínimo` : 'Todo en stock'}
      trend={stock.criticalCount > 0 ? 'down' : 'up'}
      numStyle={stock.criticalCount > 0 ? 'color:var(--accent-deep);' : ''}
      spark="0,12 10,15 20,10 30,18 40,14 52,20 64,16"
      href="/admin/stock?state=critical"
    />
    <KpiCard
      label="Cupones activos"
      count={couponKpis.active}
      delta={`${couponKpis.totalUses} usos totales · ${couponKpis.usesThisMonth} este mes`}
      spark="0,18 10,20 20,14 30,16 40,10 52,12 64,6"
      href="/admin/cupones"
    />
  </section>

  <section class="kpis" style="grid-template-columns: 1fr 1fr 1fr; margin-bottom: 32px;">
    <KpiCard
      label="Categorías activas"
      count={cats.length}
      delta={`${totalProductsByCat} productos asignados`}
      href="/admin/categorias"
    />
    <KpiCard
      label="En oferta"
      count={productCounts.sale}
      delta={`${productCounts.zero} sin stock`}
      trend={productCounts.sale > 0 ? 'up' : 'flat'}
      href="/admin/productos?view=sale"
    />
    <KpiCard
      label="Mejor cupón"
      value={couponKpis.topByConv?.code ?? '—'}
      delta={couponKpis.topByConv ? `${couponKpis.topByConv.usedCount} usos` : 'Sin datos'}
      numStyle="font-size: 28px;"
      trend="up"
      href="/admin/cupones"
    />
  </section>

  <section class="row-2">
    <div class="panel">
      <div class="panel-head">
        <h3>Distribución del catálogo</h3>
        <span style="font-family:var(--mono); font-size:11px; color:var(--ink-soft);">{totalProductsByCat} productos</span>
      </div>
      <div class="chart">
        <svg viewBox="0 0 600 240" preserveAspectRatio="none" aria-label="Productos por categoría">
          <defs>
            <linearGradient id="grad-cats" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#CB674C" stop-opacity="0.3" />
              <stop offset="100%" stop-color="#CB674C" stop-opacity="0" />
            </linearGradient>
          </defs>
          <line x1="0" y1="60" x2="600" y2="60" stroke="#E8D7CF" stroke-dasharray="3 3" />
          <line x1="0" y1="120" x2="600" y2="120" stroke="#E8D7CF" stroke-dasharray="3 3" />
          <line x1="0" y1="180" x2="600" y2="180" stroke="#E8D7CF" stroke-dasharray="3 3" />
          {
            cats.map((c, i) => {
              const barW = Math.max(20, Math.min(70, 540 / Math.max(cats.length, 1) - 20));
              const x = 30 + i * (540 / cats.length);
              const h = (c.productCount / maxCatCount) * 160;
              const y = 200 - h;
              return (
                <a href={`/admin/productos?cat=${c.id}`} class="chart-bar" style={`--bar-delay: ${i * 80}ms`}>
                  <title>{c.name} · {c.productCount} {c.productCount === 1 ? 'producto' : 'productos'}</title>
                  <rect
                    x={x}
                    y={y}
                    width={barW}
                    height={h}
                    fill="url(#grad-cats)"
                    stroke="#CB674C"
                    stroke-width="1"
                    rx="2"
                    style={`transform-origin: ${x + barW / 2}px 200px;`}
                  />
                  <text
                    x={x + barW / 2}
                    y="220"
                    text-anchor="middle"
                    font-family="JetBrains Mono"
                    font-size="10"
                    fill="#918B85"
                  >
                    {c.name.slice(0, 7)}
                  </text>
                  <text
                    x={x + barW / 2}
                    y={Math.max(y - 6, 12)}
                    text-anchor="middle"
                    font-family="JetBrains Mono"
                    font-size="11"
                    fill="#36160E"
                    font-weight="600"
                  >
                    {c.productCount}
                  </text>
                </a>
              );
            })
          }
        </svg>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head"><h3>Por categoría</h3></div>
      <div class="donut">
        <svg viewBox="0 0 42 42" aria-label="Donut de categorías" class="donut-svg">
          <circle cx="21" cy="21" r="15.915" fill="white" stroke="#F0E1DA" stroke-width="6" />
          {
            donutWithCat.map((s, i) => (
              <a href={`/admin/productos?cat=${s.catId}`} class="donut-segment" style={`--seg-delay: ${i * 100}ms`}>
                <title>{s.name} · {s.pct}%</title>
                <circle
                  cx="21"
                  cy="21"
                  r="15.915"
                  fill="transparent"
                  stroke={s.color}
                  stroke-width="6"
                  stroke-dasharray={s.dasharray}
                  stroke-dashoffset={String(s.dashoffset)}
                />
              </a>
            ))
          }
          <text x="21" y="22" text-anchor="middle" font-family="Cormorant Garamond" font-size="6" fill="#2B1510">{topCatPct}%</text>
        </svg>
        <ul class="donut-list">
          {
            donutWithCat.map((s) => (
              <li>
                <a href={`/admin/productos?cat=${s.catId}`} class="donut-list-link">
                  <span class="lbl">
                    <span class="dot" style={`background:${s.color}`} />
                    {s.name}
                  </span>
                  <span class="amt">{s.pct}%</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="row-2">
    <div class="panel">
      <div class="panel-head">
        <h3>Top productos por valor</h3>
        <a href="/admin/productos">Ver todos →</a>
      </div>
      <table class="table">
        <thead>
          <tr>
            <th>Producto</th>
            <th>Precio</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {
            topProducts.map((p) => (
              <tr class="row-link" onclick={`location.href='/admin/productos/${p.id}/editar'`}>
                <td>
                  <div class="product-cell">
                    <div class="img" style="background: linear-gradient(135deg, var(--terracota-200), var(--accent));" />
                    <div><strong>{p.name}</strong></div>
                  </div>
                </td>
                <td>
                  <span style="font-family:var(--mono);">{fmtARS(p.price)}</span>
                </td>
                <td>
                  <div class="actions-cell">
                    <a href={`/admin/productos/${p.id}/editar`} class="icon-action" aria-label="Editar">
                      <svg viewBox="0 0 24 24">
                        <path d="M12 20h9" />
                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4z" />
                      </svg>
                    </a>
                  </div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="panel alert">
      <div class="panel-head">
        <h3>Stock bajo</h3>
        <a href="/admin/stock">Ver →</a>
      </div>
      {
        lowStock.length === 0 ? (
          <p style="color:var(--ink-soft); font-style:italic;">Todo el catálogo en stock saludable.</p>
        ) : (
          <ul class="list-stock">
            {lowStock.map((p) => (
              <li>
                <a href={`/admin/productos/${p.id}/editar`} class="list-stock-link">
                  <div>
                    <div class="name">{p.name}</div>
                    <div class="sku">/{p.slug}</div>
                  </div>
                  <Tag tone={p.stock <= 1 ? 'red' : 'amber'}>
                    {p.stock} {p.stock === 1 ? 'unidad' : 'unidades'}
                  </Tag>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <style>
    /* Animaciones del dashboard */
    @keyframes bar-grow {
      from { transform: scaleY(0); }
      to { transform: scaleY(1); }
    }
    @keyframes donut-draw {
      from { opacity: 0; transform: rotate(-10deg); }
      to { opacity: 1; transform: rotate(0); }
    }
    .chart-bar {
      cursor: pointer;
      transition: filter 0.2s;
    }
    .chart-bar rect {
      animation: bar-grow 0.7s cubic-bezier(0.22, 1, 0.36, 1) backwards;
      animation-delay: var(--bar-delay, 0ms);
      transform-box: fill-box;
    }
    .chart-bar:hover rect {
      filter: brightness(1.05) drop-shadow(0 0 4px rgba(203, 103, 76, 0.4));
    }
    .donut-segment {
      cursor: pointer;
      transform-origin: 50% 50%;
      animation: donut-draw 0.5s ease-out backwards;
      animation-delay: var(--seg-delay, 0ms);
    }
    .donut-segment circle {
      transition: stroke-width 0.2s, filter 0.2s;
    }
    .donut-segment:hover circle {
      stroke-width: 7.5;
      filter: drop-shadow(0 0 4px rgba(203, 103, 76, 0.4));
    }
    .donut-list-link {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      padding: 6px 8px;
      margin: 0 -8px;
      border-radius: 4px;
      text-decoration: none;
      color: inherit;
      transition: background 0.15s;
    }
    .donut-list-link:hover {
      background: rgba(203, 103, 76, 0.06);
    }
    .list-stock-link {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      margin: 0 -14px;
      border-radius: 6px;
      text-decoration: none;
      color: inherit;
      transition: background 0.15s, transform 0.15s;
    }
    .list-stock-link:hover {
      background: rgba(203, 103, 76, 0.07);
      transform: translateX(2px);
    }
    @media (prefers-reduced-motion: reduce) {
      .chart-bar rect,
      .donut-segment {
        animation: none;
      }
    }
  </style>
</AdminLayout>
