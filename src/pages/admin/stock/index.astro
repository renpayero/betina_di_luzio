---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import KpiCard from '../../../components/admin/KpiCard.astro';
import Tag from '../../../components/admin/Tag.astro';
import { getAdminProducts, getStockKpis } from '../../../lib/queries.ts';
import { colorName } from '../../../lib/colors.ts';

const params = Astro.url.searchParams;
const q = params.get('q')?.trim() ?? '';
const stateView = params.get('state') ?? 'all';

const [kpis, products] = await Promise.all([
  getStockKpis(),
  getAdminProducts({ q }),
]);

const rows = products.filter((p) => {
  if (stateView === 'critical') return p.stock <= 1;
  if (stateView === 'low') return p.stock > 1 && p.stock < p.minStock + 1;
  if (stateView === 'ok') return p.stock > p.minStock;
  if (stateView === 'zero') return p.stock === 0;
  return true;
});

const fmtRel = (d: Date): string => {
  const diff = Math.max(0, Date.now() - d.getTime());
  const days = Math.floor(diff / (1000 * 60 * 60 * 24));
  if (days === 0) return 'hoy';
  if (days === 1) return 'ayer';
  return `hace ${days} días`;
};
---

<AdminLayout title="Stock · Inventario" subtitle="Controlá unidades y mínimos por pieza.">
  <section class="kpis">
    <KpiCard
      label="Total unidades"
      count={kpis.totalUnits}
      delta={`en ${kpis.productCount} productos`}
    />
    <KpiCard
      label="Stock crítico"
      count={kpis.criticalCount}
      delta="≤ 1 unidad"
      trend={kpis.criticalCount > 0 ? 'down' : 'flat'}
      numStyle={kpis.criticalCount > 0 ? 'color:var(--accent-deep);' : ''}
    />
    <KpiCard
      label="Reposición sugerida"
      count={kpis.restockCount}
      delta="bajo mínimo"
      trend={kpis.restockCount > 0 ? 'down' : 'up'}
    />
    <KpiCard
      label="Valor inventario"
      count={kpis.inventoryValue}
      format="ars"
      delta="suma stock × precio"
      trend="up"
    />
  </section>

  <form class="toolbar" method="get" action="/admin/stock">
    <input
      type="search"
      name="q"
      value={q}
      placeholder="Buscar producto o SKU…"
      data-filter-rows
      autocomplete="off"
    />
    <div class="right">
      <select name="state" data-filter-submit>
        <option value="all" selected={stateView === 'all'}>Todos los estados</option>
        <option value="critical" selected={stateView === 'critical'}>Crítico (≤1)</option>
        <option value="low" selected={stateView === 'low'}>Bajo (≤ mínimo)</option>
        <option value="ok" selected={stateView === 'ok'}>OK</option>
        <option value="zero" selected={stateView === 'zero'}>Sin stock</option>
      </select>
      <button type="submit" class="btn-secondary" data-filter-hidden-on-auto>Filtrar</button>
    </div>
  </form>

  <div class="panel" style="padding: 0;">
    {
      rows.length === 0 ? (
        <p style="padding:32px; color:var(--ink-soft); font-style:italic; text-align:center;">
          Sin resultados.
        </p>
      ) : (
        <table class="table">
          <thead>
            <tr>
              <th>Producto</th>
              <th>SKU</th>
              <th>Variantes</th>
              <th>Stock</th>
              <th>Mínimo</th>
              <th>Estado</th>
              <th>Última actualización</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {rows.map((p) => {
              const isZero = p.stock === 0;
              const isLow = !isZero && p.stock < p.minStock + 1;
              const tone: 'red' | 'amber' | 'green' = isZero ? 'red' : isLow ? 'amber' : 'green';
              const label = isZero ? 'Sin stock' : isLow ? 'Bajo' : 'OK';
              const variantsText = `${p.sizes.length || 1} talles · ${p.colors.length || 1} colores`;
              return (
                <tr>
                  <td>
                    <strong>{p.name}</strong>
                    <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft);">
                      {p.colors.slice(0, 3).map((c) => (
                        <span class="swatch-inline" style={`background:${c}`} title={colorName(c)} />
                      ))}
                    </div>
                  </td>
                  <td>
                    <span style="font-family:var(--mono); font-size:11px;">{p.sku ?? '—'}</span>
                  </td>
                  <td>
                    <span style="font-family:var(--mono); font-size:11px; color:var(--ink-soft);">
                      {variantsText}
                    </span>
                  </td>
                  <td>
                    <form method="post" action={`/api/admin/stock/${p.id}/actualizar`} style="display:flex; gap:6px; align-items:center;">
                      <input
                        type="number"
                        name="stock"
                        value={p.stock}
                        min="0"
                        max="9999"
                        style="width:80px; padding:6px 8px; font-family:var(--mono); border:1px solid var(--line); border-radius:4px;"
                      />
                      <button type="submit" class="btn-secondary" style="padding:6px 12px; font-size:10px;">Guardar</button>
                    </form>
                  </td>
                  <td>
                    <span style="color:var(--ink-soft); font-family:var(--mono); font-size:12px;">{p.minStock}</span>
                  </td>
                  <td>
                    <Tag tone={tone}>{label}</Tag>
                  </td>
                  <td>
                    <span style="color:var(--ink-soft); font-family:var(--mono); font-size:11px;">
                      {fmtRel(p.updatedAt)}
                    </span>
                  </td>
                  <td>
                    <a href={`/admin/productos/${p.id}/editar`} class="icon-action" aria-label="Editar producto">
                      <svg viewBox="0 0 24 24">
                        <path d="M12 20h9" />
                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4z" />
                      </svg>
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      )
    }
  </div>
</AdminLayout>
