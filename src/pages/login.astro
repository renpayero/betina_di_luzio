---
import BaseLayout from '../layouts/BaseLayout.astro';

const errorMap: Record<string, string> = {
  'Datos incompletos.': 'Revisá email y contraseña (mínimo 6 caracteres).',
  'Email o contraseña incorrectos.': 'Email o contraseña incorrectos.',
  'Demasiados intentos. Probá en un minuto.':
    'Demasiados intentos. Esperá un minuto antes de reintentar.',
};
const rawError = Astro.url.searchParams.get('error') ?? '';
const errorMsg = rawError ? (errorMap[rawError] ?? rawError) : '';
const next = Astro.url.searchParams.get('next') ?? '';
const action = next
  ? `/api/auth/login?next=${encodeURIComponent(next)}`
  : '/api/auth/login';
const rememberedEmail = Astro.cookies.get('bdl_remember_email')?.value ?? '';
---

<BaseLayout title="Ingresar" description="Acceso al panel de administración." active="login" hideChrome noindex>
  <main id="main" class="login-page" tabindex="-1">
    <aside class="login-side">
      <div class="logo">
        Betina<span class="ampersand"> · </span>Di Luzio
      </div>
      <h2 class="serif">Cada punto guarda <em>una historia.</em></h2>
      <p class="quote">
        "Tejer me lleva a las tardes con mi abuela. Quiero dejar una parte mía
        en cada prenda." <br />— Lili
      </p>
    </aside>

    <div class="login-form-wrap">
      <div class="login-form">
        <a href="/" class="back-link">← Volver al sitio</a>
        <div class="eyebrow">— Acceso</div>
        <h1>Ingresá <br />a tu cuenta</h1>
        <p class="lede">
          Para gestionar tu tienda, ver pedidos y métricas.
        </p>

        <div class="demo-hint">
          <strong>Demo:</strong> credenciales seed
          <code>admin@betinadiluzio.com</code> / <code>tejido2026</code>.
          Sesión real con cookies httpOnly y Argon2id.
        </div>

        {errorMsg && (
          <div class="form-error" role="alert">{errorMsg}</div>
        )}

        <form id="login-form" method="post" action={action} novalidate>
          <div class="field">
            <label for="login-email">Email</label>
            <input
              id="login-email"
              type="email"
              name="email"
              value={rememberedEmail}
              required
              autocomplete="email"
              placeholder="admin@betinadiluzio.com"
            />
          </div>
          <div class="field">
            <label for="login-password">Contraseña</label>
            <input
              id="login-password"
              type="password"
              name="password"
              required
              minlength="6"
              autocomplete="current-password"
            />
          </div>
          <div class="form-row">
            <label class="remember">
              <input type="checkbox" name="remember" checked={Boolean(rememberedEmail)} /> Recordarme
            </label>
          </div>
          <button type="submit"> Ingresar al panel </button>
        </form>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  body {
    background: var(--bg);
  }
  .login-page {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
  }
  .login-side {
    background: var(--bg-deep);
    color: var(--bg);
    padding: 60px 56px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
  }
  .login-side::before {
    content: '';
    position: absolute;
    inset: -60px;
    background-image: repeating-linear-gradient(
      45deg,
      transparent 0 20px,
      rgba(252, 245, 244, 0.04) 20px 21px
    );
  }
  .login-side .logo {
    font-family: var(--serif);
    font-size: 32px;
    position: relative;
  }
  .login-side .ampersand {
    color: var(--terracota-200);
    font-style: italic;
  }
  .login-side h2 {
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 400;
    line-height: 1.05;
    max-width: 480px;
    position: relative;
  }
  .login-side h2 em {
    font-style: italic;
    color: var(--terracota-200);
  }
  .login-side .quote {
    font-family: var(--serif);
    font-style: italic;
    font-size: 19px;
    opacity: 0.7;
    max-width: 380px;
    position: relative;
  }

  .login-form-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px;
  }
  .login-form {
    width: 100%;
    max-width: 380px;
  }
  .login-form .eyebrow {
    color: var(--accent-deep);
    margin-bottom: 12px;
  }
  .login-form h1 {
    font-family: var(--serif);
    font-size: 44px;
    margin-bottom: 12px;
  }
  .login-form .lede {
    color: var(--ink-soft);
    margin-bottom: 36px;
  }
  .login-form .field {
    margin-bottom: 16px;
  }
  .login-form .form-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 8px 0 24px;
    font-size: 13px;
  }
  .login-form .form-row a {
    color: var(--accent-deep);
  }
  .login-form .form-row a:hover {
    text-decoration: underline;
  }
  .remember {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--ink-soft);
    font-family: inherit;
    text-transform: none;
    letter-spacing: 0;
    font-size: 13px;
  }
  .login-form button[type='submit'] {
    width: 100%;
    padding: 16px;
    background: var(--ink);
    color: var(--bg);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    margin-bottom: 20px;
    transition: background 0.3s;
  }
  .login-form button[type='submit']:hover {
    background: var(--accent-deep);
  }
  .login-form .divider {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 24px 0;
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .login-form .divider::before,
  .login-form .divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }
  .login-form .signup {
    text-align: center;
    color: var(--ink-soft);
    font-size: 14px;
    margin-top: 24px;
  }
  .login-form .signup a {
    color: var(--accent-deep);
    text-decoration: underline;
  }
  .demo-hint {
    background: var(--bg-warm);
    padding: 12px 14px;
    border-radius: 4px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-soft);
    margin-bottom: 16px;
    line-height: 1.5;
  }
  .demo-hint strong {
    color: var(--accent-deep);
  }
  .demo-hint code {
    font-family: var(--mono);
    font-size: 11px;
    background: var(--bg);
    padding: 1px 6px;
    border-radius: 3px;
  }
  .form-error {
    background: var(--terracota-100);
    color: var(--terracota-900);
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    margin-bottom: 16px;
    border-left: 3px solid var(--terracota-700);
  }
  .login-form input[type='email'],
  .login-form input[type='password'] {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg-card);
    font-family: var(--sans);
    font-size: 15px;
    color: var(--ink);
  }
  .login-form input[type='email']:focus,
  .login-form input[type='password']:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }
  .login-form label {
    display: block;
    font-family: var(--mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-soft);
    margin-bottom: 6px;
  }
  .login-form .remember {
    margin-bottom: 0;
  }
  .back-link {
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-soft);
    margin-bottom: 32px;
    display: inline-block;
  }
  .back-link:hover {
    color: var(--accent);
  }
  @media (max-width: 800px) {
    .login-page {
      grid-template-columns: 1fr;
    }
    .login-side {
      padding: 32px;
    }
    .login-form-wrap {
      padding: 32px;
    }
  }
</style>

